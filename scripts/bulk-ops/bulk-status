# Show the status of the pull requests opened by bulk-push across a set of
# repositories.
#
# Usage:
#   bulk-status -s <set> -b <branch>
#
# Options:
#   -s, --set <name|path>   Repository set name from repos/ (e.g. "charms",
#                           "all") or a path to a file listing repositories.
#   -b, --branch <name>     Head branch of the pull requests to inspect.
#   -h, --help              Show this help text.
#
# Example:
#   bulk-status -s all -b chore/sync-contributing

set -euo pipefail

SETS="$(cd "$(dirname "${BASH_SOURCE[0]}")/repos" && pwd)"

SET=""
BRANCH=""

usage() {
	sed -n '/^# Show the status/,/^[^#]/p' "${BASH_SOURCE[0]}" | sed 's/^# \?//' | head -n -1
}

die() {
	echo "bulk-status: error: $*" >&2
	exit 1
}

while [ $# -gt 0 ]; do
	case "$1" in
	-s | --set)
		SET="$2"
		shift 2
		;;
	-b | --branch)
		BRANCH="$2"
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown option '$1' (see --help)"
		;;
	esac
done

[ -n "$SET" ] || die "missing required option --set"
[ -n "$BRANCH" ] || die "missing required option --branch"

if [ -f "$SET" ]; then
	SET_FILE="$SET"
elif [ -f "$SETS/$SET" ]; then
	SET_FILE="$SETS/$SET"
else
	die "unknown repository set '$SET' (looked in $SETS/)"
fi

mapfile -t REPOS < <(grep -vE '^\s*(#|$)' "$SET_FILE")
[ ${#REPOS[@]} -gt 0 ] || die "repository set '$SET' is empty"

command -v gh >/dev/null || die "the GitHub CLI (gh) is required"
gh auth status >/dev/null 2>&1 || die "not logged in to the GitHub CLI (run 'gh auth login')"

for repo in "${REPOS[@]}"; do
	pr="$(gh pr list --repo "$repo" --head "$BRANCH" --state open \
		--json number,url,mergeStateStatus,reviewDecision \
		--jq '.[] | "\(.url)\t\(.mergeStateStatus // "unknown")\t\(.reviewDecision // "no-review")"')"
	if [ -z "$pr" ]; then
		printf '%-40s %s\n' "$repo" "no open pull request"
	else
		printf '%-40s %s\n' "$repo" "$pr"
	fi
done
